# Bloqueia qualquer acesso direto a esta pasta via navegador.
# Models, Controllers, Views e Services só devem ser carregados
# internamente pelo index.php, nunca acessados por rota pública.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
