# Bloqueia qualquer acesso direto a esta pasta via navegador.
# As migrations só devem ser executadas via linha de comando (PHP CLI),
# nunca por rota HTTP pública (ver docs/FSD.md, Seção 11).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
