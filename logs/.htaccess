# Bloqueia qualquer acesso direto a esta pasta via navegador.
# Contém o log de contingência em arquivo (logs/erros/) usado quando o
# banco de dados está indisponível (ver docs/FSD.md, Seção 19).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
